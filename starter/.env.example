# Local-only connection for the provided Docker Compose setup.
QDRANT_PATH=results/qdrant

# Choose ONE provider if you use an API; local embeddings do not need an API key.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Local multilingual model; download occurs on its first use.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
